{
  "manifest_version": 2,
  "id": "community.wows-yuyuko",
  "name": "战舰世界战绩查询",
  "version": "1.0.2",
  "description": "战舰世界（World of Warships）战绩查询：/wws 指令渲染水表图片，数据来自 yuyuko API。MaiBot 移植版，基于 AstrBot 插件 AstrByWowsYuyukoBot（西行寺雨季）内置 hikari-core v2.0.1。",
  "author": {
    "name": "白云鱼海",
    "url": "https://github.com/BYYH-5316/MaiByWowsYoyukoBot"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/BYYH-5316/MaiByWowsYoyukoBot",
    "homepage": "https://github.com/BYYH-5316/MaiByWowsYoyukoBot",
    "issues": "https://github.com/BYYH-5316/MaiByWowsYoyukoBot/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.16.99"
  },
  "plugin_type": "other",
  "display": {
    "icon": { "type": "local", "value": "assets/icon.png" }
  },
  "dependencies": [
    { "type": "python_package", "name": "loguru", "version_spec": ">=0.7.0" },
    { "type": "python_package", "name": "APScheduler", "version_spec": ">=3.10.1" },
    { "type": "python_package", "name": "httpx", "version_spec": ">=0.28.0" },
    { "type": "python_package", "name": "h2", "version_spec": ">=4.0.0" },
    { "type": "python_package", "name": "pydantic", "version_spec": ">=2.0.3" },
    { "type": "python_package", "name": "pillow", "version_spec": ">=10.0.0" },
    { "type": "python_package", "name": "playwright", "version_spec": "==1.58.0" }
  ],
  "capabilities": ["send.text", "send.image", "config.get"],
  "changelog": "CHANGELOG.md",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
